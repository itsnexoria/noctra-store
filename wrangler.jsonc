{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "noctra-store",
  "main": "src/worker.js",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/sitemap.xml", "/product", "/product/", "/blog/post", "/blog/post/"]
  }
}
